# Copy to .env.local and fill in. .env.local is never committed.
# Values: Supabase dashboard → Project Settings → API Keys
# On Vercel, put the same values in Project Settings → Environment Variables.

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret: bypasses RLS. Server-only tasks (e.g. seeding menus). Never paste it anywhere public.
SUPABASE_SECRET_KEY=sb_secret_...
